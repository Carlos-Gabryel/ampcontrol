[Unit]
Description=AmpControl Discord Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ampcontrol
Group=ampcontrol
WorkingDirectory=/var/lib/ampcontrol
ExecStart=/usr/lib/ampcontrol/ampcontrol
Environment=AMPCONTROL_CONFIG=/etc/ampcontrol/config.toml
LoadCredentialEncrypted=discord_token:/etc/credstore.encrypted/ampcontrol.discord_token
LoadCredentialEncrypted=amp_password:/etc/credstore.encrypted/ampcontrol.amp_password
Restart=on-failure
RestartSec=5s
# No stop/restart, o SIGTERM vai só para o bot, que espera as operações em
# andamento (ex.: atualização pelo ampinstmgr) terminarem antes de sair; o
# bot desiste após 15 minutos, antes deste prazo.
KillMode=mixed
TimeoutStopSec=16min
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
