#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly REPOSITORY="Carlos-Gabryel/ampcontrol"
readonly LIB_DIRECTORY="/usr/lib/ampcontrol"
readonly BINARY_PATH="$LIB_DIRECTORY/ampcontrol"
readonly WRAPPER_PATH="/usr/local/bin/ampcontrol-amp"
readonly MAINTENANCE_PATH="/usr/local/sbin/ampcontrol-maintenance"
readonly SERVICE_PATH="/etc/systemd/system/ampcontrol.service"
readonly STATE_DIRECTORY="/var/lib/ampcontrol/update-state"
readonly BACKUP_ROOT="/var/backups/ampcontrol"
readonly SERVICE_USER="ampcontrol"
readonly SERVICE_GROUP="ampcontrol"
readonly CONFIG_DIRECTORY="/etc/ampcontrol"
readonly DATA_DIRECTORY="/var/lib/ampcontrol"
readonly CREDENTIAL_DIRECTORY="/etc/credstore.encrypted"
readonly SUDOERS_PATH="/etc/sudoers.d/ampcontrol"
readonly DROPIN_DIRECTORY="/etc/systemd/system/ampcontrol.service.d"

TEMP_DIRECTORY=""
LANGUAGE="${AMPCONTROL_LANGUAGE:-}"
if [[ -z "$LANGUAGE" && -r /etc/ampcontrol/config.toml ]]; then
    LANGUAGE="$(sed -n 's/^[[:space:]]*language[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' /etc/ampcontrol/config.toml | head -n1)"
fi
[[ "$LANGUAGE" == "en-US" ]] || LANGUAGE="pt-BR"
msg() { if [[ "$LANGUAGE" == "en-US" ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

cleanup() {
    [[ -z "$TEMP_DIRECTORY" || ! -d "$TEMP_DIRECTORY" ]] || rm -rf -- "$TEMP_DIRECTORY"
}
trap cleanup EXIT

fail() {
    printf '%s: %s\n' "$(msg 'Erro' 'Error')" "$1" >&2
    exit 1
}

usage() {
    if [[ "$LANGUAGE" == "en-US" ]]; then cat <<'EOF'
Usage:
  sudo ampcontrol-maintenance update [vVERSION]
  sudo ampcontrol-maintenance rollback [BACKUP_DIRECTORY]
  sudo ampcontrol-maintenance status
  sudo ampcontrol-maintenance uninstall [--purge] [--yes]

Without a version, update installs the latest stable GitHub release.
uninstall removes the service, binaries and sudoers rule but keeps the
configuration, credentials, data, backups and the service user; --purge also
removes those. AMP and game instances are never touched. --yes skips the
confirmation prompt.
EOF
    else cat <<'EOF'
Uso:
  sudo ampcontrol-maintenance update [vVERSÃO]
  sudo ampcontrol-maintenance rollback [DIRETÓRIO_DE_BACKUP]
  sudo ampcontrol-maintenance status
  sudo ampcontrol-maintenance uninstall [--purge] [--yes]

Sem uma versão, update instala a release estável mais recente do GitHub.
uninstall remove o serviço, os binários e a regra do sudoers, mas mantém a
configuração, as credenciais, os dados, os backups e o usuário do serviço;
--purge remove também esses itens. O AMP e as instâncias de jogo nunca são
tocados. --yes pula a pergunta de confirmação.
EOF
    fi
}

require_root() {
    [[ "$(uname -s)" == Linux ]] || fail "$(msg 'somente Linux é suportado' 'only Linux is supported')"
    [[ "$EUID" -eq 0 ]] || fail "$(msg 'execute com sudo' 'run with sudo')"
}

latest_version() {
    curl -fsSL -H 'Accept: application/vnd.github+json' \
        "https://api.github.com/repos/$REPOSITORY/releases/latest" |
        python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])'
}

backup_current() {
    local version="$1"
    local backup
    backup="$BACKUP_ROOT/update-$(date -u +%Y%m%dT%H%M%SZ)-$version"
    install -d -o root -g root -m 0700 "$backup"
    [[ ! -e "$BINARY_PATH" ]] || cp -a -- "$BINARY_PATH" "$backup/ampcontrol"
    [[ ! -e "$WRAPPER_PATH" ]] || cp -a -- "$WRAPPER_PATH" "$backup/ampcontrol-amp"
    [[ ! -e "$MAINTENANCE_PATH" ]] || cp -a -- "$MAINTENANCE_PATH" "$backup/ampcontrol-maintenance"
    [[ ! -e "$SERVICE_PATH" ]] || cp -a -- "$SERVICE_PATH" "$backup/ampcontrol.service"
    "$BINARY_PATH" --version > "$backup/version" 2>/dev/null || printf '%s\n' "$(msg 'desconhecida' 'unknown')" > "$backup/version"
    install -d -o root -g root -m 0700 "$STATE_DIRECTORY"
    printf '%s\n' "$backup" > "$STATE_DIRECTORY/latest-backup"
    printf '%s' "$backup"
}

# Com Type=simple o serviço fica "active" assim que o processo nasce; só
# observando por alguns segundos dá para ver um processo que cai e volta pelo
# Restart=on-failure. Mesma função em install.sh e migrate-legacy.sh.
wait_for_stable_service() {
    local seconds="${AMPCONTROL_START_CHECK_SECONDS:-15}"
    local baseline state restarts elapsed
    baseline="$(systemctl show ampcontrol.service --property=NRestarts --value)"
    for (( elapsed = 0; elapsed < seconds; elapsed++ )); do
        sleep 1
        state="$(systemctl show ampcontrol.service --property=ActiveState --value)"
        restarts="$(systemctl show ampcontrol.service --property=NRestarts --value)"
        [[ "$state" == active && "$restarts" == "$baseline" ]] || return 1
    done
}

restore_backup() {
    local backup="$1"
    [[ "$backup" == "$BACKUP_ROOT"/update-* && -d "$backup" ]] || fail "$(msg 'backup de atualização inválido' 'invalid update backup'): $backup"
    [[ -f "$backup/ampcontrol" ]] || fail "$(msg 'o backup não contém um binário' 'the backup does not contain a binary')"
    systemctl stop ampcontrol.service || true
    install -o root -g root -m 0755 "$backup/ampcontrol" "$BINARY_PATH"
    [[ ! -f "$backup/ampcontrol-amp" ]] || install -o root -g root -m 0755 "$backup/ampcontrol-amp" "$WRAPPER_PATH"
    [[ ! -f "$backup/ampcontrol-maintenance" ]] || install -o root -g root -m 0755 "$backup/ampcontrol-maintenance" "$MAINTENANCE_PATH"
    [[ ! -f "$backup/ampcontrol.service" ]] || install -o root -g root -m 0644 "$backup/ampcontrol.service" "$SERVICE_PATH"
    systemctl daemon-reload
    systemctl restart ampcontrol.service
    wait_for_stable_service || fail "$(msg 'o serviço não permaneceu ativo após o rollback; consulte journalctl -u ampcontrol.service' 'the service did not stay active after rollback; check journalctl -u ampcontrol.service')"
    printf '%s %s\n' "$(msg 'Rollback concluído a partir de' 'Rollback completed from')" "$backup"
}

validate_staged_binary() {
    local staged_binary="$1"
    local unit="ampcontrol-validation-$$"
    local -a properties=(
        --property=User=ampcontrol
        --property=Group=ampcontrol
        --property=WorkingDirectory=/var/lib/ampcontrol
        --property=Environment=AMPCONTROL_CONFIG=/etc/ampcontrol/config.toml
    )
    local credential=""
    while IFS= read -r credential; do
        [[ -n "$credential" ]] || continue
        properties+=("--property=$credential")
    done < <(systemctl cat ampcontrol.service | sed -n 's/^[[:space:]]*\(LoadCredentialEncrypted=.*\)$/\1/p')
    systemd-run --quiet --wait --pipe --collect --unit="$unit" \
        "${properties[@]}" "$staged_binary" --check-config
}

update_ampcontrol() {
    local requested="${1:-}"
    local version
    version="${requested:-$(latest_version)}"
    [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]] || fail "$(msg 'versão inválida' 'invalid version'): $version"
    local architecture
    architecture="$(uname -m)"
    case "$architecture" in
        x86_64) architecture=amd64 ;;
        aarch64|arm64) architecture=arm64 ;;
        *) fail "$(msg 'arquitetura não suportada' 'unsupported architecture'): $architecture" ;;
    esac

    TEMP_DIRECTORY="$(mktemp -d)"
    local archive="ampcontrol_${version}_linux_${architecture}.tar.gz"
    local base_url="https://github.com/$REPOSITORY/releases/download/$version"
    printf '%s %s...\n' "$(msg 'Baixando AmpControl' 'Downloading AmpControl')" "$version"
    curl -fL --retry 3 -o "$TEMP_DIRECTORY/$archive" "$base_url/$archive"
    curl -fL --retry 3 -o "$TEMP_DIRECTORY/checksums.txt" "$base_url/checksums.txt"
    (
        cd "$TEMP_DIRECTORY"
        grep -F "$archive" checksums.txt | sha256sum -c -
    ) || fail "$(msg 'a soma SHA-256 da release não confere' 'the release SHA-256 checksum does not match')"
    tar -tzf "$TEMP_DIRECTORY/$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))' && fail "$(msg 'a release contém caminhos inseguros' 'the release contains unsafe paths')"
    tar -xzf "$TEMP_DIRECTORY/$archive" -C "$TEMP_DIRECTORY"
    local package="$TEMP_DIRECTORY/ampcontrol_${version}_linux_${architecture}"
    [[ -x "$package/ampcontrol" ]] || fail "$(msg 'binário ausente na release' 'binary missing from the release')"
    "$package/ampcontrol" --version

    install -o root -g root -m 0755 "$package/ampcontrol" "$LIB_DIRECTORY/ampcontrol.new"
    if ! validate_staged_binary "$LIB_DIRECTORY/ampcontrol.new"; then
        rm -f -- "$LIB_DIRECTORY/ampcontrol.new"
        fail "$(msg 'a nova versão rejeitou a configuração atual; nada foi substituído' 'the new version rejected the current configuration; nothing was replaced')"
    fi

    local backup
    backup="$(backup_current "$version")"
    if ! mv -f -- "$LIB_DIRECTORY/ampcontrol.new" "$BINARY_PATH" ||
       ! install -o root -g root -m 0755 "$package/scripts/ampcontrol-amp" "$WRAPPER_PATH" ||
       ! install -o root -g root -m 0755 "$package/scripts/ampcontrol-maintenance" "$MAINTENANCE_PATH" ||
       ! install -o root -g root -m 0644 "$package/packaging/systemd/ampcontrol.service" "$SERVICE_PATH"; then
        restore_backup "$backup"
        fail "$(msg 'a instalação falhou e o backup foi restaurado' 'installation failed and the backup was restored')"
    fi
    systemctl daemon-reload
    if ! systemctl restart ampcontrol.service || ! wait_for_stable_service; then
        restore_backup "$backup"
        fail "$(msg 'a nova versão não iniciou e o rollback automático foi executado' 'the new version did not start and automatic rollback was performed')"
    fi
    printf '%s %s. %s: %s\n' "$(msg 'AmpControl atualizado para' 'AmpControl updated to')" "$version" "$(msg 'Backup' 'Backup')" "$backup"
}

show_status() {
    printf '%s: ' "$(msg 'Versão instalada' 'Installed version')"
    "$BINARY_PATH" --version
    systemctl --no-pager --full status ampcontrol.service
    if [[ -f "$STATE_DIRECTORY/latest-backup" ]]; then
        printf '%s: %s\n' "$(msg 'Último backup' 'Latest backup')" "$(<"$STATE_DIRECTORY/latest-backup")"
    fi
}

# Desinstala o AmpControl. Só toca em caminhos do próprio AmpControl; nunca no
# AMP, no usuário amp, nas instâncias ou no ampinstmgr. Itens ausentes são
# ignorados, então rodar de novo é seguro.
uninstall_ampcontrol() {
    local purge=0 assume_yes=0 argument
    for argument in "$@"; do
        case "$argument" in
            --purge) purge=1 ;;
            --yes|-y) assume_yes=1 ;;
            *) usage >&2; exit 2 ;;
        esac
    done

    local -a credentials=()
    local credential
    if [[ -d "$CREDENTIAL_DIRECTORY" ]]; then
        for credential in "$CREDENTIAL_DIRECTORY"/ampcontrol.*; do
            if [[ -e "$credential" ]]; then credentials+=("$credential"); fi
        done
    fi

    printf '%s
' "$(msg 'Será removido:' 'Will be removed:')"
    printf '  %s (+ %s)
' "$SERVICE_PATH" "$DROPIN_DIRECTORY"
    printf '  %s
  %s
  %s
  %s
' "$SUDOERS_PATH" "$WRAPPER_PATH" "$LIB_DIRECTORY" "$MAINTENANCE_PATH"
    if ((purge)); then
        printf '  %s
  %s
  %s
' "$CONFIG_DIRECTORY" "$DATA_DIRECTORY" "$BACKUP_ROOT"
        for credential in "${credentials[@]}"; do printf '  %s
' "$credential"; done
        printf '  %s %s:%s
' "$(msg 'usuário/grupo' 'user/group')" "$SERVICE_USER" "$SERVICE_GROUP"
    else
        printf '
%s
' "$(msg 'Será mantido (a reinstalação reaproveita tudo isto):' 'Will be kept (reinstalling reuses all of this):')"
        printf '  %s
  %s
  %s
' "$CONFIG_DIRECTORY" "$DATA_DIRECTORY" "$BACKUP_ROOT"
        for credential in "${credentials[@]}"; do printf '  %s
' "$credential"; done
        printf '  %s %s:%s
' "$(msg 'usuário/grupo' 'user/group')" "$SERVICE_USER" "$SERVICE_GROUP"
        printf '%s
' "$(msg 'Use --purge para remover também a configuração, as credenciais, os dados, os backups e o usuário.' 'Use --purge to also remove the configuration, credentials, data, backups and user.')"
    fi
    printf '
%s

' "$(msg 'O AMP, o usuário amp e as instâncias de jogo NÃO são tocados.' 'AMP, the amp user and game instances are NOT touched.')"

    if ((! assume_yes)); then
        local word answer=""
        word="$(msg 'remover' 'remove')"
        printf '%s ' "$(msg "Digite '$word' para confirmar:" "Type '$word' to confirm:")"
        read -r answer || true
        if [[ "${answer,,}" != "$word" ]]; then
            printf '
'
            fail "$(msg 'desinstalação cancelada; nada foi removido' 'uninstall cancelled; nothing was removed')"
        fi
    fi

    systemctl stop ampcontrol.service 2>/dev/null || true
    systemctl disable ampcontrol.service >/dev/null 2>&1 || true
    rm -f -- "$SERVICE_PATH"
    rm -rf -- "$DROPIN_DIRECTORY"
    systemctl daemon-reload || true
    systemctl reset-failed ampcontrol.service >/dev/null 2>&1 || true
    # Só o arquivo do AmpControl; outros arquivos do sudoers.d ficam como estão.
    rm -f -- "$SUDOERS_PATH"
    rm -f -- "$WRAPPER_PATH"
    rm -rf -- "$LIB_DIRECTORY"

    if ((purge)); then
        rm -rf -- "$CONFIG_DIRECTORY" "$DATA_DIRECTORY" "$BACKUP_ROOT"
        if ((${#credentials[@]})); then
            rm -f -- "${credentials[@]}"
            rmdir -- "$CREDENTIAL_DIRECTORY" 2>/dev/null || true
        fi
        if getent passwd "$SERVICE_USER" >/dev/null; then
            userdel "$SERVICE_USER" || true
        fi
        if getent group "$SERVICE_GROUP" >/dev/null; then
            groupdel "$SERVICE_GROUP" || true
        fi
    fi

    # Por último: o próprio script (o bash já o abriu, então segue rodando).
    rm -f -- "$MAINTENANCE_PATH"

    printf '%s
' "$(msg 'AmpControl desinstalado.' 'AmpControl uninstalled.')"
    if ((! purge)); then
        printf '%s
' "$(msg "Mantidos: $CONFIG_DIRECTORY, $DATA_DIRECTORY, $BACKUP_ROOT e o usuário $SERVICE_USER. Reinstalar reaproveita esses dados." "Kept: $CONFIG_DIRECTORY, $DATA_DIRECTORY, $BACKUP_ROOT and the $SERVICE_USER user. Reinstalling reuses this data.")"
    fi
}

case "${1:-}" in
    update)
        require_root
        update_ampcontrol "${2:-}"
        ;;
    rollback)
        require_root
        backup="${2:-}"
        if [[ -z "$backup" && -f "$STATE_DIRECTORY/latest-backup" ]]; then
            backup="$(<"$STATE_DIRECTORY/latest-backup")"
        fi
        [[ -n "$backup" ]] || fail "$(msg 'nenhum backup foi informado ou registrado' 'no backup was provided or recorded')"
        restore_backup "$backup"
        ;;
    status)
        require_root
        show_status
        ;;
    uninstall)
        require_root
        uninstall_ampcontrol "${@:2}"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
