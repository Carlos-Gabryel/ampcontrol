#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly REPOSITORY="Carlos-Gabryel/ampcontrol"
readonly LIB_DIRECTORY="/usr/lib/ampcontrol"
readonly BINARY_PATH="$LIB_DIRECTORY/ampcontrol"
readonly WRAPPER_PATH="/usr/local/bin/ampcontrol-amp"
readonly MAINTENANCE_PATH="/usr/local/sbin/ampcontrol-maintenance"
readonly SERVICE_PATH="/etc/systemd/system/ampcontrol.service"
readonly UPDATE_SERVICE_PATH="/etc/systemd/system/ampcontrol-update.service"
readonly UPDATE_TIMER_PATH="/etc/systemd/system/ampcontrol-update.timer"
readonly STATE_DIRECTORY="/var/lib/ampcontrol/update-state"
readonly BACKUP_ROOT="/var/backups/ampcontrol"
readonly SERVICE_USER="ampcontrol"
readonly SERVICE_GROUP="ampcontrol"
readonly CONFIG_DIRECTORY="/etc/ampcontrol"
readonly DATA_DIRECTORY="/var/lib/ampcontrol"
readonly CREDENTIAL_DIRECTORY="/etc/credstore.encrypted"
readonly SUDOERS_PATH="/etc/sudoers.d/ampcontrol"
readonly DROPIN_DIRECTORY="/etc/systemd/system/ampcontrol.service.d"

TEMP_DIRECTORY=""
LANGUAGE="${AMPCONTROL_LANGUAGE:-}"
if [[ -z "$LANGUAGE" && -r /etc/ampcontrol/config.toml ]]; then
    LANGUAGE="$(sed -n 's/^[[:space:]]*language[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' /etc/ampcontrol/config.toml | head -n1)"
fi
[[ "$LANGUAGE" == "en-US" ]] || LANGUAGE="pt-BR"
msg() { if [[ "$LANGUAGE" == "en-US" ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

cleanup() {
    [[ -z "$TEMP_DIRECTORY" || ! -d "$TEMP_DIRECTORY" ]] || rm -rf -- "$TEMP_DIRECTORY"
}
trap cleanup EXIT

fail() {
    printf '%s: %s\n' "$(msg 'Erro' 'Error')" "$1" >&2
    exit 1
}

usage() {
    if [[ "$LANGUAGE" == "en-US" ]]; then cat <<'EOF'
Usage:
  sudo ampcontrol-maintenance update [vVERSION]
  sudo ampcontrol-maintenance auto-update
  sudo ampcontrol-maintenance rollback [BACKUP_DIRECTORY]
  sudo ampcontrol-maintenance set-token
  sudo ampcontrol-maintenance status
  sudo ampcontrol-maintenance uninstall [--purge] [--yes]

Without a version, update installs the latest stable GitHub release.
auto-update is run daily by ampcontrol-update.timer: it installs the latest
stable release only if it is newer, rolling back on failure (it also waits up to 2 minutes for the bot to connect to
Discord without gateway errors or reconnect loops) and skipping a version that
failed twice. Disable with: systemctl disable --now ampcontrol-update.timer
uninstall removes the service, binaries and sudoers rule but keeps the
configuration, credentials, data, backups and the service user; --purge also
removes those. AMP and game instances are never touched. --yes skips the
confirmation prompt.
set-token replaces the Discord bot token (e.g. after Reset Token in the
Developer Portal): it reads the token without echo (or from stdin), checks it
with Discord, restarts the bot and restores the old token if it does not
connect.
EOF
    else cat <<'EOF'
Uso:
  sudo ampcontrol-maintenance update [vVERSÃO]
  sudo ampcontrol-maintenance auto-update
  sudo ampcontrol-maintenance rollback [DIRETÓRIO_DE_BACKUP]
  sudo ampcontrol-maintenance set-token
  sudo ampcontrol-maintenance status
  sudo ampcontrol-maintenance uninstall [--purge] [--yes]

Sem uma versão, update instala a release estável mais recente do GitHub.
auto-update roda todo dia pelo ampcontrol-update.timer: instala a release
estável mais recente só se for mais nova, faz rollback em caso de falha (também espera até 2 minutos o bot conectar ao
Discord sem erros de gateway nem loop de reconexão) e ignora uma versão que
já falhou duas vezes. Desative com: systemctl disable --now ampcontrol-update.timer
uninstall remove o serviço, os binários e a regra do sudoers, mas mantém a
configuração, as credenciais, os dados, os backups e o usuário do serviço;
--purge remove também esses itens. O AMP e as instâncias de jogo nunca são
tocados. --yes pula a pergunta de confirmação.
set-token troca o token do bot do Discord (ex.: depois de Reset Token no
Developer Portal): lê o token sem eco (ou da entrada padrão), confere com o
Discord, reinicia o bot e restaura o token antigo se ele não conectar.
EOF
    fi
}

require_root() {
    [[ "$(uname -s)" == Linux ]] || fail "$(msg 'somente Linux é suportado' 'only Linux is supported')"
    [[ "$EUID" -eq 0 ]] || fail "$(msg 'execute com sudo' 'run with sudo')"
}

latest_version() {
    # AMPCONTROL_LATEST_VERSION existe só para os testes.
    if [[ -n "${AMPCONTROL_LATEST_VERSION:-}" ]]; then
        printf '%s\n' "$AMPCONTROL_LATEST_VERSION"
        return
    fi
    curl -fsSL -H 'Accept: application/vnd.github+json' \
        "https://api.github.com/repos/$REPOSITORY/releases/latest" |
        python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])'
}

# Mesmas funções de scripts/install.sh (discord_application_id_from_token,
# valid_discord_bot_token e discord_token_help): mantenha as duas cópias iguais.
discord_application_id_from_token() {
    local segment="${1%%.*}"
    local decoded=""
    segment="${segment//-/+}"
    segment="${segment//_//}"
    while ((${#segment} % 4 != 0)); do segment+="="; done
    decoded="$(printf '%s' "$segment" | base64 -d 2>/dev/null || true)"
    if [[ "$decoded" =~ ^[0-9]{17,20}$ ]]; then
        printf '%s' "$decoded"
    fi
    return 0
}

# Token de bot válido: três segmentos não vazios separados por ponto e o
# primeiro decodifica para o ID da aplicação. Nunca imprime o valor.
valid_discord_bot_token() {
    local token="$1"
    local first="" second="" third="" rest=""
    [[ "$token" == *.*.* ]] || return 1
    IFS=. read -r first second third rest <<<"$token"
    [[ -n "$first" && -n "$second" && -n "$third" && -z "$rest" ]] || return 1
    [[ -n "$(discord_application_id_from_token "$token")" ]]
}

discord_token_help() {
    msg 'Isto não parece um token de bot. Use Developer Portal → sua aplicação → Bot → Reset Token (não use Client Secret nem Public Key). O token tem três partes separadas por ponto.' 'This does not look like a bot token. Use Developer Portal → your application → Bot → Reset Token (do not use the Client Secret or Public Key). The token has three parts separated by dots.'
}

# Diretório de estado do root: nunca seguir link simbólico.
ensure_state_directory() {
    [[ ! -L "$STATE_DIRECTORY" ]] || fail "$(msg 'diretório de estado é um link simbólico' 'state directory is a symbolic link'): $STATE_DIRECTORY"
    install -d -o root -g root -m 0700 "$STATE_DIRECTORY"
}

backup_current() {
    local version="$1"
    local backup
    backup="$BACKUP_ROOT/update-$(date -u +%Y%m%dT%H%M%SZ)-$version"
    install -d -o root -g root -m 0700 "$backup"
    [[ ! -e "$BINARY_PATH" ]] || cp -a -- "$BINARY_PATH" "$backup/ampcontrol"
    [[ ! -e "$WRAPPER_PATH" ]] || cp -a -- "$WRAPPER_PATH" "$backup/ampcontrol-amp"
    [[ ! -e "$MAINTENANCE_PATH" ]] || cp -a -- "$MAINTENANCE_PATH" "$backup/ampcontrol-maintenance"
    [[ ! -e "$SERVICE_PATH" ]] || cp -a -- "$SERVICE_PATH" "$backup/ampcontrol.service"
    "$BINARY_PATH" --version > "$backup/version" 2>/dev/null || printf '%s\n' "$(msg 'desconhecida' 'unknown')" > "$backup/version"
    ensure_state_directory
    printf '%s\n' "$backup" > "$STATE_DIRECTORY/latest-backup"
    printf '%s' "$backup"
}

# Com Type=simple o serviço fica "active" assim que o processo nasce; só
# observando por alguns segundos dá para ver um processo que cai e volta pelo
# Restart=on-failure. Mesma função em install.sh e migrate-legacy.sh.
wait_for_stable_service() {
    local seconds="${AMPCONTROL_START_CHECK_SECONDS:-15}"
    local baseline state restarts elapsed
    baseline="$(systemctl show ampcontrol.service --property=NRestarts --value)"
    for (( elapsed = 0; elapsed < seconds; elapsed++ )); do
        sleep 1
        state="$(systemctl show ampcontrol.service --property=ActiveState --value)"
        restarts="$(systemctl show ampcontrol.service --property=NRestarts --value)"
        [[ "$state" == active && "$restarts" == "$baseline" ]] || return 1
    done
}

service_journal_since() {
    journalctl -u ampcontrol.service --since "@$1" -o cat --no-pager 2>/dev/null || true
}

# O processo pode ficar vivo com o gateway do Discord em loop de reconexão;
# por isso exige "Discord conectado" exatamente uma vez e nenhum erro de gateway.
verify_discord_health() {
    local since="$1"
    local seconds="${AMPCONTROL_HEALTH_CHECK_SECONDS:-120}"
    local elapsed output connected
    for (( elapsed = 0; elapsed < seconds; elapsed += 5 )); do
        sleep 5
        output="$(service_journal_since "$since")"
        if grep -Eiq 'error while parsing gateway message|failed to reconnect gateway|failed to open gateway' <<<"$output"; then
            printf '%s\n' "$(msg 'erro no gateway do Discord detectado no journal' 'Discord gateway error detected in the journal')" >&2
            return 1
        fi
        if [[ "$(systemctl show ampcontrol.service --property=ActiveState --value)" != active ]]; then
            printf '%s\n' "$(msg 'o serviço deixou de estar ativo' 'the service stopped being active')" >&2
            return 1
        fi
    done
    output="$(service_journal_since "$since")"
    connected="$(grep -Eic 'Discord (conectado|connected)' <<<"$output" || true)"
    if ((connected == 0)); then
        printf '%s\n' "$(msg 'o bot não conectou ao Discord' 'the bot did not connect to Discord')" >&2
        return 1
    fi
    if ((connected > 1)); then
        printf '%s\n' "$(msg 'o bot reconectou ao Discord repetidamente' 'the bot reconnected to Discord repeatedly')" >&2
        return 1
    fi
}

restore_backup() {
    local backup="$1"
    [[ "$backup" == "$BACKUP_ROOT"/update-* && -d "$backup" ]] || fail "$(msg 'backup de atualização inválido' 'invalid update backup'): $backup"
    [[ -f "$backup/ampcontrol" ]] || fail "$(msg 'o backup não contém um binário' 'the backup does not contain a binary')"
    systemctl stop ampcontrol.service || true
    install -o root -g root -m 0755 "$backup/ampcontrol" "$BINARY_PATH"
    [[ ! -f "$backup/ampcontrol-amp" ]] || install -o root -g root -m 0755 "$backup/ampcontrol-amp" "$WRAPPER_PATH"
    [[ ! -f "$backup/ampcontrol-maintenance" ]] || install -o root -g root -m 0755 "$backup/ampcontrol-maintenance" "$MAINTENANCE_PATH"
    [[ ! -f "$backup/ampcontrol.service" ]] || install -o root -g root -m 0644 "$backup/ampcontrol.service" "$SERVICE_PATH"
    systemctl daemon-reload
    systemctl restart ampcontrol.service
    wait_for_stable_service || fail "$(msg 'o serviço não permaneceu ativo após o rollback; consulte journalctl -u ampcontrol.service' 'the service did not stay active after rollback; check journalctl -u ampcontrol.service')"
    printf '%s %s\n' "$(msg 'Rollback concluído a partir de' 'Rollback completed from')" "$backup"
}

validate_staged_binary() {
    local staged_binary="$1"
    local unit="ampcontrol-validation-$$"
    local -a properties=(
        --property=User=ampcontrol
        --property=Group=ampcontrol
        --property=WorkingDirectory=/var/lib/ampcontrol
        --property=Environment=AMPCONTROL_CONFIG=/etc/ampcontrol/config.toml
    )
    local credential=""
    while IFS= read -r credential; do
        [[ -n "$credential" ]] || continue
        properties+=("--property=$credential")
    done < <(systemctl cat ampcontrol.service | sed -n 's/^[[:space:]]*\(LoadCredentialEncrypted=.*\)$/\1/p')
    systemd-run --quiet --wait --pipe --collect --unit="$unit" \
        "${properties[@]}" "$staged_binary" --check-config
}

update_ampcontrol() {
    local requested="${1:-}"
    local version
    local timer_existed=false
    [[ ! -e "$UPDATE_TIMER_PATH" ]] || timer_existed=true
    version="${requested:-$(latest_version)}"
    [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]] || fail "$(msg 'versão inválida' 'invalid version'): $version"
    local architecture
    architecture="$(uname -m)"
    case "$architecture" in
        x86_64) architecture=amd64 ;;
        aarch64|arm64) architecture=arm64 ;;
        *) fail "$(msg 'arquitetura não suportada' 'unsupported architecture'): $architecture" ;;
    esac

    TEMP_DIRECTORY="$(mktemp -d)"
    local archive="ampcontrol_${version}_linux_${architecture}.tar.gz"
    local base_url="https://github.com/$REPOSITORY/releases/download/$version"
    printf '%s %s...\n' "$(msg 'Baixando AmpControl' 'Downloading AmpControl')" "$version"
    curl -fL --retry 3 -o "$TEMP_DIRECTORY/$archive" "$base_url/$archive"
    curl -fL --retry 3 -o "$TEMP_DIRECTORY/checksums.txt" "$base_url/checksums.txt"
    (
        cd "$TEMP_DIRECTORY"
        grep -F "$archive" checksums.txt | sha256sum -c -
    ) || fail "$(msg 'a soma SHA-256 da release não confere' 'the release SHA-256 checksum does not match')"
    tar -tzf "$TEMP_DIRECTORY/$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))' && fail "$(msg 'a release contém caminhos inseguros' 'the release contains unsafe paths')"
    tar -xzf "$TEMP_DIRECTORY/$archive" -C "$TEMP_DIRECTORY"
    local package="$TEMP_DIRECTORY/ampcontrol_${version}_linux_${architecture}"
    [[ -x "$package/ampcontrol" ]] || fail "$(msg 'binário ausente na release' 'binary missing from the release')"
    "$package/ampcontrol" --version

    install -o root -g root -m 0755 "$package/ampcontrol" "$LIB_DIRECTORY/ampcontrol.new"
    if ! validate_staged_binary "$LIB_DIRECTORY/ampcontrol.new"; then
        rm -f -- "$LIB_DIRECTORY/ampcontrol.new"
        fail "$(msg 'a nova versão rejeitou a configuração atual; nada foi substituído' 'the new version rejected the current configuration; nothing was replaced')"
    fi

    local backup
    backup="$(backup_current "$version")"
    if ! mv -f -- "$LIB_DIRECTORY/ampcontrol.new" "$BINARY_PATH" ||
       ! install -o root -g root -m 0755 "$package/scripts/ampcontrol-amp" "$WRAPPER_PATH" ||
       ! install -o root -g root -m 0755 "$package/scripts/ampcontrol-maintenance" "$MAINTENANCE_PATH" ||
       ! install -o root -g root -m 0644 "$package/packaging/systemd/ampcontrol.service" "$SERVICE_PATH"; then
        restore_backup "$backup"
        fail "$(msg 'a instalação falhou e o backup foi restaurado' 'installation failed and the backup was restored')"
    fi
    local unit
    for unit in ampcontrol-update.service ampcontrol-update.timer; do
        if [[ -f "$package/packaging/systemd/$unit" ]]; then
            install -o root -g root -m 0644 "$package/packaging/systemd/$unit" "/etc/systemd/system/$unit" || true
        fi
    done
    systemctl daemon-reload
    # Primeira vez que a unit do timer aparece: liga. Se já existia, respeita a escolha do usuário.
    if [[ "$timer_existed" == false && -f "$UPDATE_TIMER_PATH" ]]; then
        systemctl enable --now ampcontrol-update.timer >/dev/null 2>&1 || true
    fi
    local started
    started="$(date +%s)"
    if ! systemctl restart ampcontrol.service || ! wait_for_stable_service || {
        printf '%s\n' "$(msg "Verificando a conexão com o Discord (até ${AMPCONTROL_HEALTH_CHECK_SECONDS:-120} s)..." "Checking the Discord connection (up to ${AMPCONTROL_HEALTH_CHECK_SECONDS:-120} s)...")"
        ! verify_discord_health "$started"
    }; then
        restore_backup "$backup"
        fail "$(msg 'a nova versão não iniciou ou não conectou ao Discord e o rollback automático foi executado' 'the new version did not start or did not connect to Discord and automatic rollback was performed')"
    fi
    printf '%s %s. %s: %s\n' "$(msg 'AmpControl atualizado para' 'AmpControl updated to')" "$version" "$(msg 'Backup' 'Backup')" "$backup"
}

auto_update() {
    local installed latest failed_marker="$STATE_DIRECTORY/auto-update-failed"
    installed="$("$BINARY_PATH" --version 2>/dev/null | sed -n 's/^.*\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$/\1/p' | head -n1)" || true
    if [[ -z "$installed" ]]; then
        printf '%s\n' "$(msg 'Versão instalada não é uma release estável (vX.Y.Z); atualização automática ignorada.' 'Installed version is not a stable release (vX.Y.Z); automatic update skipped.')"
        return 0
    fi
    # Serviço desabilitado de propósito (ex.: instalado com --no-start): não ligar por conta própria.
    if ! systemctl is-enabled --quiet ampcontrol.service; then
        printf '%s\n' "$(msg 'ampcontrol.service não está habilitado; atualização automática ignorada.' 'ampcontrol.service is not enabled; automatic update skipped.')"
        return 0
    fi
    latest="$(latest_version)" || fail "$(msg 'não foi possível consultar a última release' 'could not query the latest release')"
    [[ "$latest" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "$(msg 'versão inválida' 'invalid version'): $latest"
    if [[ "$latest" == "$installed" || "$(printf '%s\n%s\n' "$installed" "$latest" | sort -V | tail -n1)" != "$latest" ]]; then
        printf '%s (%s)\n' "$(msg 'AmpControl já está atualizado' 'AmpControl is already up to date')" "$installed"
        return 0
    fi
    if [[ -f "$failed_marker" ]] && (( $(grep -cxF -- "$latest" "$failed_marker" || true) >= 2 )); then
        printf '%s\n' "$(msg "A versão $latest já falhou duas vezes nesta máquina e será ignorada até sair uma release mais nova (a atualização manual com 'update' continua permitida)." "Version $latest failed twice on this machine and is skipped until a newer release is published (manual 'update' is still allowed).")"
        return 0
    fi
    printf '%s %s -> %s\n' "$(msg 'Atualização automática:' 'Automatic update:')" "$installed" "$latest"
    local status=0
    # Subshell porque fail() dá exit. O set +e de fora é herdado, então o
    # subshell religa o set -e para update_ampcontrol abortar em qualquer erro.
    set +e
    ( set -e; trap cleanup EXIT; update_ampcontrol "$latest" )
    status=$?
    set -e
    if ((status != 0)); then
        ensure_state_directory
        printf '%s\n' "$latest" >> "$failed_marker"
        printf '%s\n' "$(msg "A atualização automática para $latest falhou e foi revertida; a versão é ignorada após duas falhas." "Automatic update to $latest failed and was rolled back; the version is skipped after two failures.")" >&2
        return "$status"
    fi
    rm -f -- "$failed_marker"
}

# Troca o token do bot: valida o formato, confirma com o Discord ANTES de
# mexer em qualquer coisa, grava a credencial criptografada e só dá o trabalho
# por feito se o bot conectar; senão restaura a credencial anterior.
set_token() {
    local token="" header_file="" status_code="" curl_status=0
    local destination="$CREDENTIAL_DIRECTORY/ampcontrol.discord_token"
    # AMPCONTROL_DISCORD_API existe só para os testes.
    local api="${AMPCONTROL_DISCORD_API:-https://discord.com/api/v10}"

    if [[ -t 0 ]]; then
        read -rsp "$(msg 'Novo token do bot do Discord: ' 'New Discord bot token: ')" token || true
        printf '
' >&2
    else
        IFS= read -r token || true
    fi
    token="${token//[[:space:]]/}"
    if ! valid_discord_bot_token "$token"; then
        token=""
        fail "$(discord_token_help)"
    fi

    # O token vai num arquivo 0600 (umask 077) e não no argv, onde o ps o mostraria.
    [[ -n "$TEMP_DIRECTORY" ]] || TEMP_DIRECTORY="$(mktemp -d)"
    header_file="$TEMP_DIRECTORY/discord-header"
    printf 'Authorization: Bot %s
' "$token" > "$header_file"
    status_code="$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' -H @"$header_file" "$api/users/@me")" || curl_status=$?
    rm -f -- "$header_file"
    if ((curl_status != 0)); then
        token=""
        fail "$(msg 'não foi possível falar com o Discord para verificar o token; nada foi alterado' 'could not reach Discord to verify the token; nothing was changed')"
    fi
    if [[ "$status_code" == 401 ]]; then
        token=""
        fail "$(msg 'o Discord recusou este token; nada foi alterado' 'Discord rejected this token; nothing was changed')"
    fi
    if [[ "$status_code" != 200 ]]; then
        token=""
        fail "$(msg "resposta inesperada do Discord (HTTP $status_code); nada foi alterado" "unexpected Discord response (HTTP $status_code); nothing was changed")"
    fi

    local backup="" temporary="$destination.new"
    install -d -o root -g root -m 0700 "$CREDENTIAL_DIRECTORY"
    if [[ -e "$destination" ]]; then
        backup="$destination.bak-$(date -u +%Y%m%dT%H%M%SZ)"
        cp -a -- "$destination" "$backup"
        chmod 0600 "$backup"
    fi
    printf '%s' "$token" | systemd-creds encrypt --with-key=host --name=discord_token - "$temporary" >/dev/null
    token=""
    chown root:root "$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$destination"

    systemctl reset-failed ampcontrol.service || true
    local started
    started="$(date +%s)"
    systemctl restart ampcontrol.service || true
    printf '%s
' "$(msg "Verificando a conexão com o Discord (até ${AMPCONTROL_HEALTH_CHECK_SECONDS:-120} s)..." "Checking the Discord connection (up to ${AMPCONTROL_HEALTH_CHECK_SECONDS:-120} s)...")"
    if ! { wait_for_stable_service && verify_discord_health "$started"; }; then
        if [[ -n "$backup" ]]; then
            cp -a -- "$backup" "$destination"
        else
            rm -f -- "$destination"
        fi
        systemctl reset-failed ampcontrol.service || true
        systemctl restart ampcontrol.service || true
        fail "$(msg 'o bot não conectou com o novo token; o token antigo foi restaurado' 'the bot did not connect with the new token; the old token was restored')"
    fi
    printf '%s
' "$(msg 'Token atualizado e bot conectado ao Discord.' 'Token updated and the bot is connected to Discord.')"
}

show_status() {
    printf '%s: ' "$(msg 'Versão instalada' 'Installed version')"
    "$BINARY_PATH" --version
    systemctl --no-pager --full status ampcontrol.service
    if [[ -f "$STATE_DIRECTORY/latest-backup" ]]; then
        printf '%s: %s\n' "$(msg 'Último backup' 'Latest backup')" "$(<"$STATE_DIRECTORY/latest-backup")"
    fi
}

# Desinstala o AmpControl. Só toca em caminhos do próprio AmpControl; nunca no
# AMP, no usuário amp, nas instâncias ou no ampinstmgr. Itens ausentes são
# ignorados, então rodar de novo é seguro.
uninstall_ampcontrol() {
    local purge=0 assume_yes=0 argument
    for argument in "$@"; do
        case "$argument" in
            --purge) purge=1 ;;
            --yes|-y) assume_yes=1 ;;
            *) usage >&2; exit 2 ;;
        esac
    done

    local -a credentials=()
    local credential
    if [[ -d "$CREDENTIAL_DIRECTORY" ]]; then
        for credential in "$CREDENTIAL_DIRECTORY"/ampcontrol.*; do
            if [[ -e "$credential" ]]; then credentials+=("$credential"); fi
        done
    fi

    printf '%s
' "$(msg 'Será removido:' 'Will be removed:')"
    printf '  %s (+ %s)
' "$SERVICE_PATH" "$DROPIN_DIRECTORY"
    printf '  %s
  %s
  %s
  %s
' "$SUDOERS_PATH" "$WRAPPER_PATH" "$LIB_DIRECTORY" "$MAINTENANCE_PATH"
    if ((purge)); then
        printf '  %s
  %s
  %s
' "$CONFIG_DIRECTORY" "$DATA_DIRECTORY" "$BACKUP_ROOT"
        for credential in "${credentials[@]}"; do printf '  %s
' "$credential"; done
        printf '  %s %s:%s
' "$(msg 'usuário/grupo' 'user/group')" "$SERVICE_USER" "$SERVICE_GROUP"
    else
        printf '
%s
' "$(msg 'Será mantido (a reinstalação reaproveita tudo isto):' 'Will be kept (reinstalling reuses all of this):')"
        printf '  %s
  %s
  %s
' "$CONFIG_DIRECTORY" "$DATA_DIRECTORY" "$BACKUP_ROOT"
        for credential in "${credentials[@]}"; do printf '  %s
' "$credential"; done
        printf '  %s %s:%s
' "$(msg 'usuário/grupo' 'user/group')" "$SERVICE_USER" "$SERVICE_GROUP"
        printf '%s
' "$(msg 'Use --purge para remover também a configuração, as credenciais, os dados, os backups e o usuário.' 'Use --purge to also remove the configuration, credentials, data, backups and user.')"
    fi
    printf '
%s

' "$(msg 'O AMP, o usuário amp e as instâncias de jogo NÃO são tocados.' 'AMP, the amp user and game instances are NOT touched.')"

    if ((! assume_yes)); then
        local word answer=""
        word="$(msg 'remover' 'remove')"
        printf '%s ' "$(msg "Digite '$word' para confirmar:" "Type '$word' to confirm:")"
        read -r answer || true
        if [[ "${answer,,}" != "$word" ]]; then
            printf '
'
            fail "$(msg 'desinstalação cancelada; nada foi removido' 'uninstall cancelled; nothing was removed')"
        fi
    fi

    systemctl stop ampcontrol.service 2>/dev/null || true
    systemctl disable ampcontrol.service >/dev/null 2>&1 || true
    systemctl disable --now ampcontrol-update.timer >/dev/null 2>&1 || true
    rm -f -- "$SERVICE_PATH" "$UPDATE_SERVICE_PATH" "$UPDATE_TIMER_PATH"
    rm -rf -- "$DROPIN_DIRECTORY"
    systemctl daemon-reload || true
    systemctl reset-failed ampcontrol.service >/dev/null 2>&1 || true
    # Só o arquivo do AmpControl; outros arquivos do sudoers.d ficam como estão.
    rm -f -- "$SUDOERS_PATH"
    rm -f -- "$WRAPPER_PATH"
    rm -rf -- "$LIB_DIRECTORY"

    if ((purge)); then
        rm -rf -- "$CONFIG_DIRECTORY" "$DATA_DIRECTORY" "$BACKUP_ROOT"
        if ((${#credentials[@]})); then
            rm -f -- "${credentials[@]}"
            rmdir -- "$CREDENTIAL_DIRECTORY" 2>/dev/null || true
        fi
        if getent passwd "$SERVICE_USER" >/dev/null; then
            userdel "$SERVICE_USER" || true
        fi
        if getent group "$SERVICE_GROUP" >/dev/null; then
            groupdel "$SERVICE_GROUP" || true
        fi
    fi

    # Por último: o próprio script (o bash já o abriu, então segue rodando).
    rm -f -- "$MAINTENANCE_PATH"

    printf '%s
' "$(msg 'AmpControl desinstalado.' 'AmpControl uninstalled.')"
    if ((! purge)); then
        printf '%s
' "$(msg "Mantidos: $CONFIG_DIRECTORY, $DATA_DIRECTORY, $BACKUP_ROOT e o usuário $SERVICE_USER. Reinstalar reaproveita esses dados." "Kept: $CONFIG_DIRECTORY, $DATA_DIRECTORY, $BACKUP_ROOT and the $SERVICE_USER user. Reinstalling reuses this data.")"
    fi
}

case "${1:-}" in
    update)
        require_root
        update_ampcontrol "${2:-}"
        ;;
    auto-update)
        require_root
        auto_update
        ;;
    rollback)
        require_root
        backup="${2:-}"
        if [[ -z "$backup" && -f "$STATE_DIRECTORY/latest-backup" ]]; then
            backup="$(<"$STATE_DIRECTORY/latest-backup")"
        fi
        [[ -n "$backup" ]] || fail "$(msg 'nenhum backup foi informado ou registrado' 'no backup was provided or recorded')"
        restore_backup "$backup"
        ;;
    set-token)
        require_root
        set_token
        ;;
    status)
        require_root
        show_status
        ;;
    uninstall)
        require_root
        uninstall_ampcontrol "${@:2}"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
