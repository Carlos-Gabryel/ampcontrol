#!/usr/bin/env bash

set -Eeuo pipefail

readonly RUNTIME_CONFIG="/etc/ampcontrol/amp-runtime.conf"

if [[ -r "$RUNTIME_CONFIG" ]]; then
    # O arquivo é criado pelo instalador, pertence ao root e não é gravável
    # pelo usuário do serviço ou pelo usuário AMP.
    # shellcheck source=/dev/null
    source "$RUNTIME_CONFIG"
fi

: "${AMPINSTMGR:=/usr/bin/ampinstmgr}"
: "${INSTANCES_DIRECTORY:=/home/amp/.ampdata/instances}"
readonly AMPINSTMGR
readonly INSTANCES_DIRECTORY
readonly PROTECTED_INSTANCE="ADS01"
LANGUAGE="${AMPCONTROL_LANGUAGE:-}"
if [[ -z "$LANGUAGE" && -r /etc/ampcontrol/config.toml ]]; then
    LANGUAGE="$(sed -n 's/^[[:space:]]*language[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' /etc/ampcontrol/config.toml | head -n1)"
fi
[[ "$LANGUAGE" == "en-US" ]] || LANGUAGE="pt-BR"
msg() { if [[ "$LANGUAGE" == "en-US" ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

show_usage() {
    if [[ "$LANGUAGE" == "en-US" ]]; then cat <<'EOF'
Usage:
  ampcontrol-amp list
  ampcontrol-amp status
  ampcontrol-amp start INSTANCE
  ampcontrol-amp stop INSTANCE
  ampcontrol-amp restart INSTANCE
  ampcontrol-amp update INSTANCE
EOF
    else cat <<'EOF'
Uso:
  ampcontrol-amp list
  ampcontrol-amp status
  ampcontrol-amp start INSTANCIA
  ampcontrol-amp stop INSTANCIA
  ampcontrol-amp restart INSTANCIA
  ampcontrol-amp update INSTANCIA
EOF
    fi
}

fail() {
    printf '%s: %s\n' "$(msg 'Erro' 'Error')" "$1" >&2
    exit 1
}

validate_instance() {
    local instance_name="$1"

    if [[ -z "$instance_name" ]]; then
        fail "$(msg 'o nome da instância não foi informado' 'the instance name was not provided')"
    fi

    if [[ ! "$instance_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        fail "$(msg 'o nome da instância contém caracteres inválidos' 'the instance name contains invalid characters')"
    fi

    if [[ "$instance_name" == "$PROTECTED_INSTANCE" ]]; then
        fail "$(msg 'a instância ADS01 é protegida e não pode ser controlada pelo bot' 'the ADS01 instance is protected and cannot be controlled by the bot')"
    fi

    if [[ ! -d "$INSTANCES_DIRECTORY/$instance_name" ]]; then
        fail "$(msg 'a instância' 'instance') '$instance_name' $(msg 'não existe' 'does not exist')"
    fi
}

require_no_extra_arguments() {
    if [[ "$#" -ne 1 ]]; then
        show_usage >&2
        exit 2
    fi
}

require_instance_argument() {
    if [[ "$#" -ne 2 ]]; then
        show_usage >&2
        exit 2
    fi

    validate_instance "$2"
}

main() {
    if [[ "$#" -lt 1 ]]; then
        show_usage >&2
        exit 2
    fi

    local operation="$1"

    case "$operation" in
        list)
            require_no_extra_arguments "$@"
            exec "$AMPINSTMGR" --ShowInstancesList
            ;;

        status)
            require_no_extra_arguments "$@"
            exec "$AMPINSTMGR" status
            ;;

        start)
            require_instance_argument "$@"
            exec "$AMPINSTMGR" --StartInstance "$2"
            ;;

        stop)
            require_instance_argument "$@"
            exec "$AMPINSTMGR" --StopInstance "$2"
            ;;

        restart)
            require_instance_argument "$@"
            exec "$AMPINSTMGR" --RestartInstance "$2"
            ;;

        update)
            require_instance_argument "$@"
            exec "$AMPINSTMGR" --UpgradeInstance "$2" true
            ;;

        *)
            fail "$(msg 'operação desconhecida' 'unknown operation'): '$operation'"
            ;;
    esac
}

main "$@"
